# Secretos: nunca se suben a Git
.env
secrets/
ca-privada/

# Certificados generados con crear-ca.sh (el PC 2 recibe solo ca.crt)
certs/

# Evidencia generada en ejecuciones locales (no se versiona)
evidencias/

# Configuración local de Docker (BuildKit) y artefactos de ejecución
.docker/
__pycache__/
*.pyc
*.log

# Registros públicos de DKIM: los genera crear-dkim.sh/rotar-dkim.sh
dkim-publica/

# Claves y artefactos criptográficos sueltos, capturas y keylogs de TLS
*.key
*.pem
*.csr
*.srl
*.pcapng
tls-keylog*.txt
