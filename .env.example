# Plantilla de referencia. NO hace falta copiarla: scripts/modo.sh escribe
# .env por ustedes (scripts/modo.sh casa | scripts/modo.sh clase).
#
# Variables que leen docker-compose.yml y los scripts:
#   MODO     casa | clase  (informativo)
#   LAB_IP   IP donde se publican 25/587/993 y valor del registro SPF
#            (127.0.0.1 en casa: el servidor no es visible en la red)
#
# El antivirus ClamAV es obligatorio y no se configura aquí: su contenedor
# arranca siempre y Rspamd no acepta correo si no puede analizarlo.
MODO=casa
LAB_IP=127.0.0.1
